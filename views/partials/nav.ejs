          <a href="/signup" class="relative flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition duration-200 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70 <%= currentPage === '/signup' ? 'bg-white/15 after:scale-x-100' : 'after:scale-x-0 hover:after:scale-x-100' %> after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:bg-white after:transition-transform after:duration-200"><svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 3.75.872M4.5 19.128A9.38 9.38 0 0 1 8.25 20m6.75-3.376a3 3 0 1 0-6 0m6 0a7.5 7.5 0 1 0-6 0m6 0a7.5 7.5 0 0 1-6 0M12 6.75a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>Signup</a>
        </li>

      <% } else if (isAdmin) { %>
        <li>
          <a href="/admin/add-home" class="relative flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition duration-200 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70 <%= currentPage === '/admin/add-home' ? 'bg-white/15 after:scale-x-100' : 'after:scale-x-0 hover:after:scale-x-100' %> after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:bg-white after:transition-transform after:duration-200"><svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>Add Home</a>
