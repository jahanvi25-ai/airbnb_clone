<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="container mx-auto mt-10 px-4">
    <section class="max-w-3xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden">
      <img
        src="<%= home.photoURL %>"
        alt="<%= home.houseName %>"
        class="w-full h-80 object-cover"
      >

      <div class="p-6">
        <h1 class="text-3xl font-bold text-gray-800 mb-4">
          <%= home.homeName %>
        </h1>

        <p class="text-lg text-gray-700 mb-2">
          <span class="font-semibold">Location:</span>
          <%= home.homeLocation %>
        </p>

        <p class="text-lg text-gray-700 mb-2">
          <span class="font-semibold">Rating:</span>
          <%= Number(home.homeRating).toFixed(1) %>
        </p>

        <p class="text-xl text-green-600 font-bold mb-6">
          Rs <%= home.homePrice %> / night
        </p>
        <div class="justify-between flex">
          <div class="flex gap-3">
          <a href="/" class="bg-gray-600 text-white px-2 py-1 rounded">
            Back
          </a>

          <a href="/store/reserve" class="bg-green-700 text-white px-2 py-1 rounded">
            Reserve
          </a>
        </div>
       
         <%- include('../partials/favourites') %>
         
        </div>

      </div>
    </section>
  </main>
</body>
</html>
