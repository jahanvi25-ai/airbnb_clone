<%-include('../partials/head.ejs')%>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%-include('../partials/nav')%>
  <main class="mx-auto flex max-w-6xl items-center justify-center px-4 py-10 sm:px-6 lg:min-h-[calc(100vh-72px)] lg:px-8">
    <section class="w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-xl shadow-slate-200/70 ring-1 ring-slate-200">
      <div class="border-b border-slate-100 px-6 py-7 text-center sm:px-10">
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-red-500">Welcome home</p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Create your account</h1>
        <p class="mt-2 text-sm text-slate-500">Join to discover and book places you’ll love.</p>
      </div>

      <form action="/signup" method="POST" class="space-y-6 px-6 py-7 sm:px-10">
        <div class="grid gap-5 sm:grid-cols-2">

            <%- include("../partials/errors.ejs")%>

          <div class="relative">
            <label for="first-name" class="mb-2 block text-sm font-medium text-slate-700">First name</label>
            <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-11 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.118a7.5 7.5 0 0 1 15 0A17.93 17.93 0 0 1 12 21.75c-2.676 0-5.216-.584-7.5-1.632Z"/></svg>
            <input type="text" id="first-name" name="FirstName" required autocomplete="given-name" placeholder="John" value="<%= oldInput.FirstName ? oldInput.FirstName : "" %>"
            
            class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 placeholder:text-slate-400 transition focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-100" />
          </div>
          <div class="relative">
            <label for="last-name" class="mb-2 block text-sm font-medium text-slate-700">Last name</label>
            <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-11 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.118a7.5 7.5 0 0 1 15 0A17.93 17.93 0 0 1 12 21.75c-2.676 0-5.216-.584-7.5-1.632Z"/></svg>
            <input type="text" id="last-name" name="LastName" autocomplete="family-name" placeholder="Doe" value="<%= oldInput.LastName ? oldInput.LastName : "" %>"
            
            class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 placeholder:text-slate-400 transition focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-100" />
          </div>
        </div>

        <div class="relative">
          <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email address</label>
          <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-11 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5H4.5a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91A2.25 2.25 0 0 1 2.25 6.993V6.75"/></svg>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="johndoe@example.com" value="<%= oldInput.email ? oldInput.email : "" %>"
          class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 placeholder:text-slate-400 transition focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-100" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="relative">
            <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
            <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-11 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 0 0-9 0v3.75m-2.25 0h13.5A1.5 1.5 0 0 1 20.25 12v7.5A1.5 1.5 0 0 1 18.75 21h-13.5a1.5 1.5 0 0 1-1.5-1.5V12a1.5 1.5 0 0 1 1.5-1.5Z"/></svg>
            <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="Create a password" 
            
            class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 placeholder:text-slate-400 transition focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-100" />
          </div>
          <div class="relative">
            <label for="confirmed-password" class="mb-2 block text-sm font-medium text-slate-700">Confirm password</label>
            <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-11 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 0 0-9 0v3.75m-2.25 0h13.5A1.5 1.5 0 0 1 20.25 12v7.5A1.5 1.5 0 0 1 18.75 21h-13.5a1.5 1.5 0 0 1-1.5-1.5V12a1.5 1.5 0 0 1 1.5-1.5Z"/></svg>
            <input type="password" id="confirmed-password" name="confirmed password" required autocomplete="new-password" placeholder="Repeat your password" class="w-full rounded-lg border border-slate-300 bg-white py-3 pl-11 pr-4 text-slate-900 placeholder:text-slate-400 transition focus:border-red-500 focus:outline-none focus:ring-4 focus:ring-red-100" />
          </div>
        </div>

        <fieldset>
          <legend class="mb-3 text-sm font-medium text-slate-700">I want to join as a</legend>
          <div class="grid grid-cols-2 gap-3">
            <label for="guest" class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-red-300 hover:bg-red-50">
              <input type="radio" name="userType" value="guest" id="guest" <%= oldInput.userType === 'guest' ? 'checked' : '' %> required
               class="h-4 w-4 border-slate-300 text-red-500 focus:ring-red-500" />
              <span class="text-sm font-medium text-slate-700">Guest</span>
            </label>
            <label for="host" class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-red-300 hover:bg-red-50">
              <input type="radio" name="userType" value="host" id="host" <%= oldInput.userType === 'host' ? 'checked' : '' %>
              class="h-4 w-4 border-slate-300 text-red-500 focus:ring-red-500" />
              <span class="text-sm font-medium text-slate-700">Host</span>
            </label>
          </div>
        </fieldset>

        <label for="terms" class="flex cursor-pointer items-start gap-3 text-sm leading-5 text-slate-600">
          <input type="checkbox" name="terms" id="terms" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-red-500 focus:ring-red-500" />
          <span>I agree to the <a href="#" class="font-medium text-red-500 hover:text-red-600 hover:underline">terms and conditions</a>.</span>
        </label>

        <button type="submit" class="w-full rounded-lg bg-red-500 px-4 py-3 font-semibold text-white shadow-sm transition hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200">Create account</button>
      </form>

      <div class="border-t border-slate-100 bg-slate-50 px-6 py-5 text-center text-sm text-slate-600 sm:px-10">
        Already have an account? <a href="/login" class="font-semibold text-red-500 hover:text-red-600 hover:underline">Sign in</a>
      </div>
    </section>
  </main>
</body>
</html>
