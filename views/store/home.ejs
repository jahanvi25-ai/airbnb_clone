<%-include('../partials/head')%>
</head>
<body>
  <%-include('../partials/nav')%>

  <main class="container mx-auto px-4 py-8">
    <h2 class="mb-8 text-center text-3xl font-bold text-red-500">
      Here are Suggested homes for you:
    </h2>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% registeredHomes.forEach(home => { %>
        <li class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
          <img
            src="<%= home.photoURL %>"
            alt="<%= home.homeName %>"
            class="h-52 w-full object-cover"
          >

          <div class="p-5">
            <div class="mb-4 flex items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-bold text-gray-900">
                  <%= home.homeName %>
                </h2>
                <p class="mt-1 text-sm font-medium text-gray-500">
                  <%= home.homeLocation %>
                </p>
              </div>

              <span class="shrink-0 rounded-full bg-yellow-100 px-3 py-1 text-sm font-bold text-yellow-700">
                <%= Number(home.homeRating).toFixed(1) %>
              </span>
            </div>

            <div class="mb-5 flex items-center justify-between border-t border-gray-100 pt-4">
              <p class="text-lg font-bold text-green-700">
                Rs <%= home.homePrice %>
              </p>
              <p class="text-sm text-gray-500">per night</p>
            </div>

            <div class="flex items-center gap-3">
              <a class="rounded bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700" href="/store/home-detail/<%= home._id %>">Detail</a>
              <%-include('../partials/favourites', {home:home})%>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
