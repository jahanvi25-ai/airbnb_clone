<%-include('../partials/head.ejs')%>
</head>
<body>
  <%-include('../partials/nav')%>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">
        <%= editing ? 'Edit Your Home' : 'Register Your Home on AirBnB' %>
      </h1>
      <form
        action="<%= editing ? '/admin/edit-home' : '/admin/add-home' %>"
        method="POST"
        enctype="multipart/form-data"
        class="max-w-md mx-auto"
      >
        <% if (editing) { %>
          <input type="hidden" name="_id" value="<%= home._id %>" />
        <% } %>

        <input
          type="text"
          name="homeName"
          value="<%= home.homeName || '' %>"
          placeholder="Enter your House Name"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <input
          type="number"
          id="homePrice"
          name="homePrice"
          min="0"
          step="0.01"
          inputmode="decimal"
          value="<%= home.homePrice || '' %>"
          placeholder="Enter price in Rupees"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <input
          type="text"
          name="homeLocation"
          id="homeLocation"
          value="<%= home.homeLocation || '' %>"
          placeholder="Enter your house location"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <input
          type="number"
          id="homeRating"
          name="homeRating"
          min="0"
          max="5"
          step="0.1"
          inputmode="decimal"
          value="<%= home.homeRating || '' %>"
          placeholder="Enter rating, e.g. 3.6"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
        />

        <input
          type="text"
          id="photoURL"
          name="photoURL"
          value="<%= home.photoURL || '' %>"
          accept="image/*"
          class="w-full px-4 py-2 mb-4 border rounded-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-500"
        />
        <textarea name="homeDiscription" id="homeDiscription"
        class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500" placeholder="Enter your house discription"
          ><%= home.homeDiscription || '' %></textarea>

        <input
          type="submit"
          value="<%= editing ? 'Update Home' : 'Submit' %>"
          class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"
        />
      </form>
    </main>
</body>
</html>
