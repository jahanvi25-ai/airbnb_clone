<% if (errors.length > 0) { %>
              <div class="sm:col-span-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-700" role="alert">
                <strong class="font-bold"> Error!</strong>
                <ul class="mt-1 list-inside list-disc text-sm">
                  <% errors.forEach(error => { %>
                    <li><%= error %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>