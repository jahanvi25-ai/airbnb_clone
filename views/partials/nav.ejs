          <a href="/login" class="relative flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition duration-200 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70 <%= currentPage === '/login' ? 'bg-white/15 after:scale-x-100' : 'after:scale-x-0 hover:after:scale-x-100' %> after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:bg-white after:transition-transform after:duration-200"><svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6A2.25 2.25 0 0 0 5.25 5.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m-3-3H21m0 0-3-3m3 3-3 3"/></svg>Login</a>
